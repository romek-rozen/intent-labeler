# Any OpenAI-compatible chat completions endpoint (OpenAI, OpenRouter, LiteLLM, Ollama, vLLM).
INTENT_LLM_BASE_URL=https://openrouter.ai/api/v1
INTENT_LLM_API_KEY=
INTENT_LLM_MODEL=
# Optional: needed only for `--keyword` mode (live Google SERP).
DATAFORSEO_USERNAME=
DATAFORSEO_PASSWORD=
# Optional: where LLM responses are cached (default: .cache/llm).
INTENT_CACHE_DIR=
