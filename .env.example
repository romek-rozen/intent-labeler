# Copy to .env and fill in. Environment variables always override .env.

# --- LLM (required) ---------------------------------------------------------
# Any OpenAI-compatible /chat/completions endpoint:
#   OpenRouter  https://openrouter.ai/api/v1
#   OpenAI      https://api.openai.com/v1
#   Ollama      http://localhost:11434/v1   (API key can stay empty)
INTENT_LLM_BASE_URL=https://openrouter.ai/api/v1
INTENT_LLM_API_KEY=
# Cheap and good enough for grouping ten results: openai/gpt-6-luna
INTENT_LLM_MODEL=openai/gpt-6-luna

# Reasoning models (gpt-5.6 / gpt-6 family) reject any temperature other than
# the default - set "none" to omit it. Use 0 for classic models.
INTENT_LLM_TEMPERATURE=none
# none | low | medium | high - leave empty to omit. Grouping needs little.
INTENT_LLM_REASONING_EFFORT=low
# Reasoning tokens count against this limit too.
INTENT_LLM_MAX_TOKENS=8000
INTENT_LLM_TIMEOUT=300

# --- DataForSEO (optional) --------------------------------------------------
# Needed for --keyword (live Google SERP) and traffic estimates (etv).
# Location codes: 2616 = Poland, 2840 = United States, 2826 = United Kingdom.
DATAFORSEO_USERNAME=
DATAFORSEO_PASSWORD=

# --- Cache (optional) -------------------------------------------------------
# LLM answers are cached by prompt + input + model. Default: .cache/llm
INTENT_CACHE_DIR=
